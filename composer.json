{
    "name": "coder999/login-kit",
    "description": "PHP login kit: password and passkey login, CSRF, throttling, database sessions and roles",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Coder999\\LoginKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coder999\\LoginKit\\Tests\\": "tests/"
        }
    }
}
